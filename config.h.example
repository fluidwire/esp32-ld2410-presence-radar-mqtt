// config.h.example - copy this file to config.h and fill in your own values.
// config.h is .gitignore'd so your secrets never leave your machine.

#pragma once

// --- WiFi -------------------------------------------------------------------
#define WIFI_SSID      "your-wifi-ssid"
#define WIFI_PASSWORD  "your-wifi-password"

// --- MQTT broker ------------------------------------------------------------
#define MQTT_HOST       "broker.hivemq.com"
#define MQTT_PORT       1883
#define MQTT_CLIENT_ID  "fluidwire-esp32-ld2410"
#define MQTT_USER       ""
#define MQTT_PASSWORD   ""

// --- Topics -----------------------------------------------------------------
#define MQTT_TOPIC_STATE      "fluidwire/demo/presence/state"      // retained "occupied" / "clear"
#define MQTT_TOPIC_EVENT      "fluidwire/demo/presence/event"      // JSON on every state change
#define MQTT_TOPIC_TELEMETRY  "fluidwire/demo/presence/telemetry"  // JSON every 5 s
